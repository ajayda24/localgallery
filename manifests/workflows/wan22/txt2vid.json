{
  "1": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{file.text_encoder}}",
      "type": "wan",
      "device": "default"
    }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{file.vae}}"
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{file.high_noise}}",
      "weight_dtype": "{{weight_dtype}}"
    },
    "_meta": {
      "title": "High-noise expert"
    }
  },
  "4": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{file.low_noise}}",
      "weight_dtype": "{{weight_dtype}}"
    },
    "_meta": {
      "title": "Low-noise expert"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "3",
        0
      ],
      "lora_name": "{{file.speed_lora_high}}",
      "strength_model": "{{speed_lora}}"
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "lora_name": "{{file.speed_lora_low}}",
      "strength_model": "{{speed_lora}}"
    }
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "5",
        0
      ],
      "shift": "{{shift}}"
    }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "6",
        0
      ],
      "shift": "{{shift}}"
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "1",
        0
      ]
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "1",
        0
      ]
    }
  },
  "12": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": [
        "7",
        0
      ],
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "9",
        0
      ],
      "negative": [
        "10",
        0
      ],
      "latent_image": [
        "11",
        0
      ],
      "start_at_step": 0,
      "end_at_step": "{{switch_step}}",
      "return_with_leftover_noise": "enable"
    }
  },
  "13": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "add_noise": "disable",
      "noise_seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "9",
        0
      ],
      "negative": [
        "10",
        0
      ],
      "latent_image": [
        "12",
        0
      ],
      "start_at_step": "{{switch_step}}",
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "13",
        0
      ],
      "vae": [
        "2",
        0
      ]
    }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "14",
        0
      ],
      "fps": "{{fps}}"
    }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "15",
        0
      ],
      "filename_prefix": "LocalGallery",
      "format": "mp4",
      "format.codec": "h264"
    }
  },
  "11": {
    "class_type": "EmptyHunyuanLatentVideo",
    "inputs": {
      "width": "{{size.w}}",
      "height": "{{size.h}}",
      "length": "{{frames}}",
      "batch_size": 1
    }
  }
}
