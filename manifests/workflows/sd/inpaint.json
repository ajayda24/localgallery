{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    },
    "_meta": {
      "title": "Checkpoint"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "4",
        1
      ]
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "4",
        1
      ]
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image|asset}}"
    },
    "_meta": {
      "title": "Source image"
    }
  },
  "12": {
    "class_type": "LoadImageMask",
    "inputs": {
      "image": "{{mask|asset}}",
      "channel": "red"
    },
    "_meta": {
      "title": "Mask (white = change)"
    }
  },
  "13": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "12",
        0
      ],
      "expand": "{{grow_mask}}",
      "tapered_corners": true
    }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "10",
        0
      ],
      "vae": [
        "4",
        2
      ]
    }
  },
  "14": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "mask": [
        "13",
        0
      ]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "4",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "positive": [
        "6",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "14",
        0
      ],
      "denoise": "{{denoise}}"
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "3",
        0
      ],
      "vae": [
        "4",
        2
      ]
    }
  },
  "15": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "10",
        0
      ],
      "source": [
        "8",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": true,
      "mask": [
        "13",
        0
      ]
    },
    "_meta": {
      "title": "Keep unmasked pixels"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "15",
        0
      ],
      "filename_prefix": "LocalGallery"
    }
  }
}
