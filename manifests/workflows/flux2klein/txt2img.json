{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{file.diffusion}}",
      "weight_dtype": "{{weight_dtype}}"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{file.text_encoder}}",
      "type": "flux2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{file.vae}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "2",
        0
      ]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "2",
        0
      ]
    }
  },
  "14": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "cfg": "{{cfg}}"
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "16": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{seed}}"
    }
  },
  "17": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "16",
        0
      ],
      "guider": [
        "14",
        0
      ],
      "sampler": [
        "15",
        0
      ],
      "sigmas": [
        "13",
        0
      ],
      "latent_image": [
        "12",
        0
      ]
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "17",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "19": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "18",
        0
      ],
      "filename_prefix": "LocalGallery"
    }
  },
  "12": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": "{{size.w}}",
      "height": "{{size.h}}",
      "batch_size": "{{batch}}"
    }
  },
  "13": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": "{{steps}}",
      "width": "{{size.w}}",
      "height": "{{size.h}}"
    }
  }
}
