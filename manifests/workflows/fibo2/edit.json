{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{diffusion_file}}",
      "weight_dtype": "{{weight_dtype}}"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{text_encoder_file}}",
      "type": "fibo2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{file.vae}}"
    }
  },
  "4": {
    "class_type": "TextEncodeFibo2",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "prompt": "{{caption|json}}",
      "negative_prompt": "{{negative}}",
      "vae": [
        "3",
        0
      ],
      "images.image_1": [
        "8",
        0
      ],
      "width": 0,
      "height": 0,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "4",
        1
      ],
      "latent_image": [
        "4",
        2
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "filename_prefix": "LocalGallery"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image|asset}}"
    }
  }
}
